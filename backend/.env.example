# ---------------------------------------------------------------------------
# Local development: copy this file to .env (git-ignored) and edit as needed.
# Production: .env is NOT deployed — set each variable in your host's dashboard
# (Render/Railway/Fly) or secret manager instead. See README "Deploying".
# ---------------------------------------------------------------------------

# --- Runtime ---
NODE_ENV=development
# Local fixed port; managed hosts inject their own PORT.
PORT=4000

# --- Database (PostgreSQL) ---
# Local dev/tests use the Postgres from docker-compose.yml.
# Production: the managed database's connection string (keep ?sslmode=require).
DATABASE_URL="postgresql://ltb:ltb@localhost:5433/ltb?schema=public"

# --- CORS ---
# Comma-separated allow-list of frontend origins, e.g. https://app.example.com
CORS_ORIGIN="http://localhost:5173"

# --- Auth ---
# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be long, random, and DIFFERENT from each other. Never reuse dev secrets.
JWT_ACCESS_SECRET="omhe8GTJZYzWrBmuDBdNsGHn0IxvVP71ByK8CQmgjuW9VRC_MEDM1qes1Q23Rg8l"
JWT_REFRESH_SECRET="Ui1ys3rW4GJLRXfeKY6WTgnLJpVrbXNVxs9jyDoYqY5pWX7edPeqkGLyIUSf0cvM"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="30d"

TWO_FACTOR_ENABLED="true"
